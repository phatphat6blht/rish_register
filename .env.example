# ============================================================
# Risk Register - Environment Variables
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào git
# ============================================================

# PostgreSQL Configuration
POSTGRES_DB=risk_db
POSTGRES_USER=risk_user
POSTGRES_PASSWORD=your_secure_password_here

# Flask App Configuration
DATABASE_URL=postgresql://risk_user:your_secure_password_here@postgres:5432/risk_db
FLASK_ENV=production
SECRET_KEY=your_secret_key_here

# Metabase Configuration (kết nối read-only tới PostgreSQL)
MB_DB_TYPE=postgres
MB_DB_DBNAME=risk_db
MB_DB_PORT=5432
MB_DB_USER=metabase_readonly
MB_DB_PASS=metabase_ro_pass
MB_DB_HOST=postgres
